{
  "manifest_version": 3,
  "name": "Latch",
  "version": "0.1.0",
  "description": "Lets your AI sign in and create accounts without seeing your email or password.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Latch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "tabGroups",
    "alarms",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
