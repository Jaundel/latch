{
  "manifest_version": 3,
  "name": "Latch: sign-ins for your AI",
  "short_name": "Latch",
  "version": "1.0.0",
  "description": "Let Claude, ChatGPT and other browser AIs sign in, create accounts and pass 2FA for you without ever seeing your password.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Latch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bar.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open Latch"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "favicon",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
